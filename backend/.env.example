# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# dev | test | prod
ENV=dev

# Local: SQLite. Producción: la URL de PostgreSQL que entrega Render (postgres://...)
DATABASE_URL=sqlite:///./reservaya.db

# Solo si el front llama a la API desde otro dominio (sin el proxy de Netlify),
# separados por coma: https://reservayaok.netlify.app,http://localhost:4200
CORS_ORIGINS=
