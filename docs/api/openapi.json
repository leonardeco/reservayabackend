{
  "openapi": "3.1.0",
  "info": {
    "title": "ReservaYa API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "salud"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/restaurantes": {
      "get": {
        "tags": [
          "restaurantes"
        ],
        "summary": "Listar",
        "operationId": "listar_api_v1_restaurantes_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[^\\x00-\\x1f\\x7f]*$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "zona",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[^\\x00-\\x1f\\x7f]*$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Zona"
            }
          },
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^[^\\x00-\\x1f\\x7f]*$"
                  },
                  "maxItems": 10
                },
                {
                  "type": "null"
                }
              ],
              "title": "Categoria"
            }
          },
          {
            "name": "precio",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 3,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Precio"
            }
          },
          {
            "name": "rating_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 5,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rating Min"
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fecha"
            }
          },
          {
            "name": "personas",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 20,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Personas"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RestauranteRead"
                  },
                  "title": "Response Listar Api V1 Restaurantes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/restaurantes/{slug}": {
      "get": {
        "tags": [
          "restaurantes"
        ],
        "summary": "Detalle",
        "operationId": "detalle_api_v1_restaurantes__slug__get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestauranteRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/restaurantes/{slug}/disponibilidad": {
      "get": {
        "tags": [
          "restaurantes"
        ],
        "summary": "Disponibilidad",
        "operationId": "disponibilidad_api_v1_restaurantes__slug__disponibilidad_get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "title": "Slug"
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Fecha"
            }
          },
          {
            "name": "personas",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "title": "Personas"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisponibilidadRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/restaurantes/{slug}/reservas": {
      "post": {
        "tags": [
          "reservas"
        ],
        "summary": "Crear Reserva",
        "operationId": "crear_reserva_api_v1_restaurantes__slug__reservas_post",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "title": "Slug"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservaCrear"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaCreada"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "autenticación"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DisponibilidadRead": {
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "personas": {
            "type": "integer",
            "title": "Personas"
          },
          "franjas": {
            "items": {
              "$ref": "#/components/schemas/FranjaRead"
            },
            "type": "array",
            "title": "Franjas"
          },
          "motivo": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "cerrado",
                  "bloqueado",
                  "grupo_grande",
                  "sin_mesas"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Motivo"
          },
          "mensaje": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mensaje"
          }
        },
        "type": "object",
        "required": [
          "fecha",
          "personas",
          "franjas",
          "motivo",
          "mensaje"
        ],
        "title": "DisponibilidadRead"
      },
      "FranjaRead": {
        "properties": {
          "hora": {
            "type": "string",
            "title": "Hora"
          },
          "estado": {
            "type": "string",
            "enum": [
              "libre",
              "agotada"
            ],
            "title": "Estado"
          }
        },
        "type": "object",
        "required": [
          "hora",
          "estado"
        ],
        "title": "FranjaRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginEntrada": {
        "properties": {
          "usuario": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Usuario"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "usuario",
          "password"
        ],
        "title": "LoginEntrada"
      },
      "LoginRespuesta": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo",
            "default": "Bearer"
          },
          "vence": {
            "type": "string",
            "format": "date-time",
            "title": "Vence"
          },
          "usuario": {
            "type": "string",
            "title": "Usuario"
          },
          "restaurante": {
            "type": "string",
            "title": "Restaurante"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          }
        },
        "type": "object",
        "required": [
          "token",
          "vence",
          "usuario",
          "restaurante",
          "slug"
        ],
        "title": "LoginRespuesta"
      },
      "ReservaCreada": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo"
          },
          "restaurante": {
            "type": "string",
            "title": "Restaurante"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "ubicacion": {
            "type": "string",
            "title": "Ubicacion"
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "hora": {
            "type": "string",
            "title": "Hora"
          },
          "personas": {
            "type": "integer",
            "title": "Personas"
          },
          "mesa": {
            "type": "string",
            "title": "Mesa"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "correo": {
            "type": "string",
            "title": "Correo"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "restaurante",
          "slug",
          "ubicacion",
          "fecha",
          "hora",
          "personas",
          "mesa",
          "estado",
          "nombre",
          "correo"
        ],
        "title": "ReservaCreada"
      },
      "ReservaCrear": {
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "hora": {
            "type": "string",
            "format": "time",
            "title": "Hora"
          },
          "personas": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Personas"
          },
          "nombre": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Nombre"
          },
          "telefono": {
            "type": "string",
            "maxLength": 30,
            "minLength": 7,
            "pattern": "^\\+?[0-9 ()-]+$",
            "title": "Telefono"
          },
          "correo": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Correo"
          },
          "notas": {
            "type": "string",
            "maxLength": 500,
            "title": "Notas",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fecha",
          "hora",
          "personas",
          "nombre",
          "telefono",
          "correo"
        ],
        "title": "ReservaCrear",
        "description": "Lo que envía el formulario de reserva (mismos campos que ReservationService del front)."
      },
      "RestauranteRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "descripcion": {
            "type": "string",
            "title": "Descripcion"
          },
          "ubicacion": {
            "type": "string",
            "title": "Ubicacion"
          },
          "imagen_url": {
            "type": "string",
            "title": "Imagen Url"
          },
          "imagen_comida_url": {
            "type": "string",
            "title": "Imagen Comida Url"
          },
          "rating": {
            "type": "number",
            "title": "Rating"
          },
          "precio_nivel": {
            "type": "integer",
            "title": "Precio Nivel"
          },
          "categoria": {
            "type": "string",
            "title": "Categoria"
          },
          "horario_resumen": {
            "type": "string",
            "title": "Horario Resumen"
          },
          "telefono": {
            "type": "string",
            "title": "Telefono"
          },
          "pagina": {
            "type": "string",
            "title": "Pagina"
          },
          "popular": {
            "type": "boolean",
            "title": "Popular"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "nombre",
          "descripcion",
          "ubicacion",
          "imagen_url",
          "imagen_comida_url",
          "rating",
          "precio_nivel",
          "categoria",
          "horario_resumen",
          "telefono",
          "pagina",
          "popular"
        ],
        "title": "RestauranteRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
